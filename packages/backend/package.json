{
  "name": "@agent-player/backend",
  "version": "1.3.0",
  "description": "Agent Player Backend - CLI & API Server",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "protobufjs",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@whiskeysockets/baileys",
      "puppeteer"
    ]
  },
  "main": "dist/api/server.js",
  "bin": {
    "agent": "dist/cli/index.js"
  },
  "scripts": {
    "setup:channels": "pnpm install --frozen-lockfile",
    "build:channels": "npm --prefix ../channels run build",
    "test:channels": "node --test test/agent-connect*.test.mjs",
    "test:ollama": "node --import tsx --test test/ollama-chat.integration.test.mjs",
    "predev": "node scripts/kill-port.js",
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "cli": "tsx src/cli/index.ts",
    "setup:python": "tsx src/services/python-setup-cli.ts"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^3.1.3",
    "@clack/prompts": "^1.0.1",
    "@fastify/cors": "^10.0.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@google-cloud/speech": "^7.2.1",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@octokit/rest": "^22.0.1",
    "@types/multer": "^2.1.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "agent-connect-dpro": "0.2.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.0.0",
    "googleapis": "^171.4.0",
    "grammy": "^1.40.0",
    "i18next": "^25.8.19",
    "imap-simple": "^5.1.0",
    "isomorphic-dompurify": "^2.36.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-pty": "1.1.0",
    "nodemailer": "^10.1.2",
    "openai": "^6.22.0",
    "ora": "^8.0.1",
    "pg": "8.23.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.14.0",
    "ssh2": "^1.17.0",
    "twilio": "^5.12.2",
    "uuid": "^13.0.0",
    "vm2": "^3.10.5",
    "ws": "^8.19.0",
    "zod": "^4.3.6",
    "tsx": "^4.21.0",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "8.23.1",
    "@types/uuid": "^10.0.0",
    "typescript": "^5"
  },
  "overrides": {
    "@alpacahq/alpaca-trade-api": {
      "axios": "1.20.0",
      "msgpack5": "6.1.0"
    },
    "utf7": {
      "semver": "5.7.2"
    }
  }
}
